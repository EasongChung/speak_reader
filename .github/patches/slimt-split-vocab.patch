@@ -26,6 +26,17 @@ struct Package {
   Field vocabulary;
   Field shortlist;
   Field ssplit;
+  // Optional separate target-side vocabulary.
+  //
+  // Some models (notably Mozilla's en->CJK ones) share a single embedding
+  // matrix but ship two vocabularies with *different* id spaces: `vocabulary`
+  // maps source text to ids, this one maps generated ids back to target text.
+  // Leave it empty for the usual single-vocabulary models, in which case
+  // `vocabulary` is used for both sides exactly as before.
+  //
+  // Declared last so existing designated initializers that omit it keep
+  // compiling and value-initialize to the empty (single-vocabulary) case.
+  Field target_vocabulary;
 };
 
