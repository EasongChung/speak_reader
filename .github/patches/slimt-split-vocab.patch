+// Builds the optional target-side vocabulary. Empty view (the common,
+// single-vocabulary case) yields nullopt, and Model::target_vocabulary() then
+// falls back to the source vocabulary.
+//
+// Vocabulary holds a SentencePieceProcessor, which has a user-declared
+// destructor and unique_ptr members: it is neither copyable nor movable, and
+// so is optional<Vocabulary>. Both returns below are prvalues initialising the
+// caller's object directly (guaranteed copy elision, C++17); introducing a
+// named local here would not compile.
+std::optional<Vocabulary> target_vocabulary_from(View view) {
+  if (view.data == nullptr || view.size == 0) {
+    return std::nullopt;
+  }
+  return std::optional<Vocabulary>(std::in_place, view);
+}
