  "sources": [
    {
      "id": "release",
      "priority": 2,
      "comment": "GitHub Release 附件(不计入 LFS 配额, 单文件上限 2 GB)。附件是扁平命名空间, 故用 name 而非 path; 六个文件名本身已含语向标识(zhen/enzh), 无冲突。",
      "url_template": "https://github.com/EasongChung/speak_reader/releases/download/models-firefox-translations-v1/{name}.gz",
      "verify_with": "sha256_gz"
    },
    {
      "id": "upstream",
      "priority": 3,
      "comment": "上游权威出处, 最终回退。⚠️ 两个语向来源不同, 故 URL 逐文件写在 files[].upstream_url, 不用模板。上游 .gz 的字节哈希与我方不同, 只能按解压后 sha256 校验。",
      "verify_with": "sha256"
    }
  ],
